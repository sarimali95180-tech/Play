# ElevenLabs — used ONLY by Node generation scripts (never shipped to the browser)
# Copy to .env and fill in. .env is gitignored.

ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=your_male_urdu_capable_voice_id

# Optional. Script prefers eleven_v4 when available, else eleven_multilingual_v2.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
